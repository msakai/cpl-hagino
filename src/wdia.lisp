;;
;; Macros
;;

(defmacro nterpri ()
  '(progn (tyo 13) (terpri)))

(defmacro rascii (ch)
  "Get ASCII code of character"
  (car (exploden ch)))

(defmacro rarrow ()
  ''|->|)

(defmacro rcolon ()
  ''|:|)

(defmacro rcomp ()
  ''|.|)

(defmacro rrcomp ()
  ''|\||)

(defmacro rlpar ()
  ''|(|)

(defmacro rrpar ()
  ''|)|)

(defmacro rcomma (l)
  ''|,|)

(defmacro requal (l)
  ''|=|)

(defmacro rstar (l)
  ''|*|)

(defmacro rctrl (l)
  (- (car (exploden (cadr l))) 64))

(defmacro resc (l)
  (+ (car (exploden (cadr l))) 128))

(defmacro onext (l)
  (cond ((cdr l) `(setq ,(cadr l) (cdr ,(cadr l))))
	(t '(setq tokl (cdr tokl)))))

(defmacro pp-inc (l)
  `(setq ,(cadr l) (1+ ,(cadr l))))

(defmacro pp-dec (l)
  `(setq ,(cadr l) (1- ,(cadr l))))

(defmacro pp-cons (l)
  `(setq ,(caddr l) (cons ,(cadr l) ,(caddr l))))

(defmacro pp-cdr (l)
  `(setq ,(cadr l) (cdr ,(cadr l))))

(defmacro pp-while (l)
  `(prog () pp-while-label (cond ,(append (cdr l) '((go pp-while-label))))))

(defmacro pp-do (l)
  (prog (p c vars inits)
	(pp-cdr l)
	(pp-while l
	 (cond ((or (eq (car l) 'until) (eq (car l) 'while))
		(cond ((null (cdr l)) (error 'pp-do))
		      ((eq (car l) 'until) (setq c (cadr l)))
		      (t (setq c `(not ,(cadr l)))))
		(pp-cons `(cond (,c (return))) p)
		(pp-cdr l))
	       ((eq (car l) 'var)
		(cond ((or (null (cdr l)) (not (atom (cadr l))))
		       (error 'pp-do)))
		(pp-cons (cadr l) vars))
	       ((eq (car l) 'vars)
		(cond ((or (null (cdr l)) (not (consp (cadr l))))
		       (error 'pp-do)))
		(setq vars (append (cadr l) vars)))
	       ((eq (car l) 'init)
		(cond ((null (cdr l)) (error 'pp-do)))
		(pp-cons (cadr l) inits))
	       (t (pp-cons (car l) p)))
	 (pp-cdr l))
	(return (cons 'prog
		      (cons (nreverse vars)
			    (nconc (nreverse inits)
				   (cons 'pp-do-label
					 (nconc (nreverse p)
						'((go pp-do-label))))))))))


