(defvar *avar* nil)
(defvar *ln* nil)
(defvar *de-from* nil)
(defvar *de-sl* nil)
(defvar *de-end* nil)
(defvar *de-kill* nil)
(defvar *de-name* nil)
(defvar *erflag* nil)
(defvar *wc-l* nil)
(defvar *wc-ll* nil)
(defvar *w-ll* nil)
