	((odelmdml (car mll) aux) t)
	(t (odelmdmll (cdr mll) aux))))

(defun odelmdml (ml aux)
  (cond ((null ml) nil)
	((odelmdm (car ml) aux) t)
	(t (odelmdml (cdr ml) aux))))

(defun odelmdm (morph aux)
  (cond ((eq (car morph) 'factorizer) (odelmdmll (caddr morph) aux))
	((not (eq (car morph) 'auxiliary)) nil)
	(t (eq (cadr morph) aux))))

(defun odell (l a)
  (cond ((null l) nil)
	((memq (car l) a) (odell (cdr l) a))
	(t (cons (car l) (odell (cdr l) a)))))

(defun odelo (obj dflg)
  (prog (objl depl bd unitl ml)
	(setq objl $object)
   aa   (cond ((null objl) (go a1))
	      ((and (not (eq (car objl) obj)) (odelod (car objl) obj))
	       (setq depl (cons (car objl) depl))))
	(setq objl (cdr objl))
	(go aa)
   a1   (setq ml $morphism)
   a2   (cond ((null ml) (go bb))
	      ((and (eq (car (setq bd (get (car ml) 'morphism)))
			'auxiliary)
		    (odelodml (caddr bd) obj))
	       (setq depl (odelmd (car ml) (cons (car ml) depl)))))
	(setq ml (cdr ml))
	(go a2)
   bb	(cond (depl (cond ((not dflg) (princ "Modified ")))
		    (princ obj)
		    (princ " was used in: ")
		    (oprinl (reverse depl))
		    (nterpri)))
   b0   (cond (depl (setf (get (car depl) 'incorrect) t)
		    (setq depl (cdr depl))
		    (go b0)))
	(setq bd (get obj 'object))
	(remprop obj 'object)
	(remprop obj 'incorrect)
	(setq $object (odell $object (list obj)))
	(remprop obj 'morphism)
	(setq ml (list (caddr bd)))
	(remprop (caddr bd) 'morphism)
	(setq unitl (cadddr bd))
    cc  (cond ((null unitl)
	       (cond (dflg (setq $morphism (odell $morphism ml))
			   (princ obj)
			   (princ " deleted")
			   (nterpri)))
	       (return t)))
	(setq ml (cons (caar unitl) ml))
	(remprop (caar unitl) 'morphism)
	(setq unitl (cdr unitl))
	(go cc)))

(defun odelod (obj dobj)
  (prog (unitl)
	(setq unitl (cadddr (get obj 'object)))
   aa   (cond ((null unitl) (return nil))
	      ((or (odelodo (cadar unitl) dobj)
		   (odelodo (caddar unitl) dobj))
	       (return t)))
	(setq unitl (cdr unitl))
	(go aa)))

(defun odelodo (dom dobj)
  (cond ((atom dom) nil)
	((eq (cadr dom) dobj) t)
	(t (odelodol (caddr dom) dobj))))

(defun odelodol (doml dobj)
  (and doml (or (odelodo (car doml) dobj) (odelodol (cdr doml) dobj))))

(defun odelodmll (mll dobj)
  (and mll (or (odelodml (car mll) dobj) (odelodmll (cdr mll) dobj))))

(defun odelodml (ml dobj)
  (and ml (or (odelodm (car ml) dobj) (odelodml (cdr ml) dobj))))

(defun odelodm (m dobj)
  (cond ((eq (car m) 'unit) (eq (cadr (get (cadr m) 'morphism)) dobj))
	((eq (car m) 'factorizer)
	 (or (eq (cadr (get (cadr m) 'morphism)) dobj)
	     (odelodmll (caddr m) dobj)))
	(t nil)))

(defun oinco (o)
  (prog (unitl)
	(setq unitl (cadddr (get o 'object)))
   aa   (cond ((null unitl) (return nil))
	      ((or (oincdo (cadar unitl)) (oincdo (caddar unitl)))
	       (return t)))
	(setq unitl (cdr unitl))
	(go aa)))

(defun oincdo (oo)
  (cond ((atom oo) nil)
	((get (cadr oo) 'incorrect) t)
	(t (oincdol (caddr oo)))))

(defun oincdol (ool)
  (and ool (or (oincdo (car ool)) (oincdol (cdr ool)))))

(defun oincml (ml)
  (and ml (or (oincm (car ml)) (oincml (cdr ml)))))

(defun oincm (m)
  (cond ((eq (car m) 'unit)
	 (get (caddr (get (cadr m) 'morphism)) 'incorrect))
	((eq (car m) 'factorizer)
	 (or (get (caddr (get (cadr m) 'morphism)) 'incorrect)
	     (oincmll (caddr m))))
	((eq (car m) 'auxiliary) (get (cadr m) 'incorrect))
	(t nil)))

(defun oincmll (mll)
  (and mll (or (oincml (car mll)) (oincmll (cdr mll)))))

(defun oexpand (tokl)
  (prog (aux m ml)
   aa	(cond ((null tokl) (return nil)))
	(setq aux (car tokl))
	(setq tokl (cdr tokl))
	(cond ((null (setq m (get aux 'morphism)))
	       (oprinl `(,aux "undefined"))
	       (nterpri)
	       (go aa))
	      ((not (eq (car m) 'auxiliary))
	       (oprinl `(,aux "is not an auxiliary morphism"))
	       (nterpri)
	       (go aa)))
	(oexp aux (caddr m) (cadddr m))
	(oprinl `(,aux "expanded"))
	(nterpri)
	(go aa)))

(defun oexp (aux m vl)
  (prog (ml dc)
	(setq ml $morphism)
	(go aa)
   bb   (setq ml (cdr ml))
   aa   (cond ((null ml) (return nil))
	      ((not (eq (car (setq dc (get (car ml) 'morphism))) 'auxiliary))
	       (go bb)))
	(setf (get (car ml) 'morphism)
		 (list 'auxiliary
		       '*auxiliary
		       (oexpml (caddr dc) aux m vl)
		       (cadddr dc)
		       (car (cddddr dc))
		       (cadr (cddddr dc))))
	(go bb)))

(defun oexpmll (mll aux m vl)
  (cond ((null mll) nil)
	(t (cons (oexpml (car mll) aux m vl) (oexpmll (cdr mll) aux m vl)))))

(defun oexpml (ml aux m vl)
  (prog (rtv morph)
   aa   (cond ((null ml) (return (nreverse rtv)))
	      ((and (eq (car (setq morph (car ml))) 'auxiliary)
		    (eq (cadr morph) aux))
	       (setq rtv (revapp m rtv)))
	      ((eq (car morph) 'factorizer)
	       (setq rtv
		     (cons (list 'factorizer
				 (cadr morph)
				 (oexpmll (caddr morph) aux m vl))
			   rtv)))
	      (t (setq rtv (cons morph rtv))))
	(setq ml (cdr ml))
	(go aa)))

;; simplifier (evaluater)

(defvar $simp-full nil)
(defvar $cnt 0)

(defun simp (lazy tokl)
  (prog (m sm y edit win)
	(cond ((and tokl (memq (car tokl) '(lazy full)))
	       (setq $simp-full (eq (car tokl) 'full))
	       (pp-cdr tokl))
	      (t (setq $simp-full (eq $simp-mode 'full))))
	(cond ((not (setq edit (null tokl))) (go bb))
	      ((setq win (eq $system-mode 'window)) (we-new)))
   aa   (cond (win (w-select $w-edit t)
		   (cond ((= (wedit $w-edit) 3) (return nil)))
		   (setq $w-ll (we-get))
		   (rclear)
		   (setq tokl (rtokl 'window)))
	      (t (rclear)
		 (setq $rnl t)
		 (setq tokl (rtokl nil))
		 (wc-input nil "" "")))
	(rclear)
   bb	(setq m (errset (morph0 tokl nil) $erflag))
	(cond ((atom m) (princ "Syntax error: ")
			(oprinl $error)
			(nterpri)
			(oerrposprint tokl $errpos)
			(cond (edit (go aa)))
			(return nil)))
	(setq m (car m))
	(cond ((oincml (car m))
	       (princ "Something may have been changed. ")
	       (princ "Update must be done first.") (go zz)))
	(setq $cnt 0)
	(cond ($trace
	       (cond ((eq $system-mode 'window)
		      (w-select $w-show t)
		      (wlscroll $w-show 'bottom)
		      (whprinc $w-show "- Trace Output -")
		      (nterpri)))
	       (setq $ln (- (w-length $w-show) 10))))
	(setq sm (errset (simpl (reverse (car m)) nil 0) $erflag))
	(w-select $w-command nil)
	(cond ((atom sm) (princ "Error in evaluation.") (go zz)))
	(setq sm (car sm))
	(pmorphl sm $tplvl)
	(nterpri)
	(princ "    :")
	(pobj (caddr m))
	(princ " -> ")
	(pobj (cadddr m))
	(nterpri)
	(setq y (get 'it 'morphism))
	(cond ((or (null y) (eq (car y) 'auxiliary))
	       (oexp 'it (caddr y) (cadddr y))
	       (setf (get 'it 'morphism)
			`(auxiliary *auxiliary ,sm nil ,(caddr m) ,(cadddr m)))
	       (remprop 'it 'incorrect)
	       (cond ((not (memq 'it $morphism))
		      (setq $morphism (cons 'it $morphism))
		      (wc-update-list)))))
	(return t)
   zz	(nterpri)
	(return nil)))

(defun revapp (a b)
  (cond ((null a) b) (t (revapp (cdr a) (cons (car a) b)))))

(defun revcomp (a b)
  (cond ((null a) b) (t (revcomp (cdr a) (mcomp1 (car a) b)))))

(defun simpl (ml sml level)
  (prog (m mm obj objnm x)
   aa   (cond ($trace (princ $cnt)
		      (cond ((not (zerop level))
			     (princ "[")
			     (princ level)
			     (princ "]")))
		      (princ ":")
		      (cond ((eq $arrow-dir 'reverse)
			     (cond (sml (pmorphl sml $tplvl)))
			     (princ "*")
			     (cond (ml (pmorphl (reverse ml) $tplvl))))
			    (t (cond (ml (pmorphl (reverse ml) $tplvl)))
			       (princ "*")
			       (cond (sml (pmorphl sml $tplvl)))))
		      (nterpri)
		      (setq $cnt (1+ $cnt))))
	(cond ((null ml)
	       (cond ((null sml) (return '((identity))))
		     (t (return sml)))))
	(setq m (car ml))
	(cond ((eq (car m) 'identity) (pp-cdr ml) (go aa))
	      ((eq (car m) 'auxiliary)
	       (setq mm (get (cadr m) 'morphism))
	       (setq ml (revcomp (caddr mm) (cdr ml)))
	       (go aa))
	      ((eq (car m) 'unit)
	       (setq objnm (cadr (get (cadr m) 'morphism)))
	       (setq obj (get objnm 'object))
	       (cond ((or (null sml) (eq (car obj) 'left))
		      (setq sml (mcomp1 m sml)) (pp-cdr ml) (go aa)))
	       (setq mm (suu 'right ml sml objnm obj level))
	       (setq sml (cadr mm))
	       (setq ml (car mm))
	       (go aa))
	      ((eq (car m) 'factorizer)
	       (setq objnm (cadr (get (cadr m) 'morphism)))
	       (setq obj (get objnm 'object))
	       (cond ((eq (car obj) 'right)
		      (cond ((null (cadddr obj)) (setq sml (list m)))
			    ((and $simp-full
				  (eq (car (cddddr obj)) 'productive))
			     (setq sml (sprod m sml objnm obj level)))
			    (t (setq sml (mcomp1 m sml))))
		      (pp-cdr ml)
		      (go aa)))
	       (setq mm (suu 'left ml sml objnm obj level))
	       (setq sml (cadr mm))
	       (setq ml (car mm))
	       (go aa))
	      (t (error 0)))))

(defun sprod (m sml objnm obj level)
  (prog (para unitl argl mll mll2 ml)
	(setq para (cadr obj))
	(pp-while para
		  (pp-cons (list (car para) '((identity)) nil nil) argl)
		  (pp-cdr para))
	(pp-cons (list objnm sml nil nil) argl)
	(setq mll (caddr m))
	(setq unitl (cadddr obj))
   aa   (pp-while unitl
		  (setq ml (car (mfungt (cadar unitl) argl)))
		  (pp-cons (simpl (reverse (car mll)) ml (1+ level)) mll2)
		  (pp-cdr unitl)
		  (pp-cdr mll))
	(return (list (list 'factorizer (cadr m) (nreverse mll2))))))

(defun suu (rl ml sml objnm obj level)
  (prog (unit arrow F G right mm para argl Gml mll unitl)
	(cond ((null sml) (go zz))
	      ((setq right (eq rl 'right)) (setq unit (car ml)))
	      (t (setq unit (car sml))))
	(cond ((not (eq (car unit) 'unit)) (go zz)))
	(setq arrow (assq (cadr unit) (setq unitl (cadddr obj))))
	(cond (right (setq F (cadr arrow))
		     (setq G (caddr arrow))
		     (setq mm (suuget t F objnm sml level))
		     (cond ((null (car mm)) (setq sml (cadr mm)) (go zz)))
		     (setq sml (caddr mm)))
	      (t (setq F (caddr arrow))
		 (setq G (cadr arrow))
		 (setq mm (suuget nil F objnm ml level))
		 (cond ((null (car mm)) (setq ml (cadr mm)) (go zz)))
		 (setq ml (caddr mm))))
	(setq mm (cadr mm))
	(setq para (cadr obj))
	(pp-while para
		  (pp-cons (list (car para) '((identity)) nil nil) argl)
		  (pp-cdr para))
	(pp-cons (list objnm (list mm) nil nil) argl)
	(setq Gml (car (mfungt G argl)))
	(setq mll (caddr mm))
	(pp-while (not (eq (caar unitl) (cadr unit)))
		  (pp-cdr unitl)
		  (pp-cdr mll))
	(cond (right
	       (setq ml (revcomp Gml (cdr ml)))
	       (cond ((and $simp-full
			   (or (null sml) (equal sml '((identity))))
			   (eq (car (cddddr obj)) 'productive))
		      (setq sml (car mll)))
		     (t (setq ml (revcomp (car mll) ml)))))
	      (t (setq ml (revcomp Gml (revcomp (car mll) ml)))
		 (pp-cdr sml)))
	(return (list ml sml))
    zz  (return (list (cdr ml) (mcomp1 (car ml) sml)))))

(defun suuget (right F objnm ml level)
  (prog (univ obj unitl mll mll2 para apara argl)
	(setq univ (car ml))
	(cond ((not (eq (car univ) 'factorizer)) (go zz))
	      ((eq F objnm)
	       (cond ((not (eq (cadr (get (cadr univ) 'morphism)) objnm))
		      (go zz)))
	       (return (list t (car ml) (mcomp1 '(identity) (cdr ml)))))
	      ((not (eq (cadr F) (cadr (get (cadr univ) 'morphism)))) (go zz)))
	(setq obj (get (cadr F) 'object))
	(cond ((null (cdr ml)) (go aa)))
	(setq unitl (cadddr obj))
	(setq para (cadr obj))
	(pp-while para
		  (pp-cons (list (car para) '((identity)) nil nil) argl)
		  (pp-cdr para))
	(pp-cons (list (cadr F) (cdr ml) nil nil) argl)
	(setq mll (caddr univ))
	(pp-while unitl
		  (cond (right
			 (setq ml (car (mfungt (cadar unitl) argl)))
			 (pp-cons (mcomp (car mll) ml) mll2))
			(t (setq ml (car (mfungt (caddar unitl) argl)))
			   (pp-cons (mcomp ml (car mll)) mll2)))
		  (pp-cdr unitl)
		  (pp-cdr mll))
	(setq univ (list 'factorizer (cadr univ) (nreverse mll2)))
   aa   (setq para (cadr obj))
	(setq apara (caddr F))
	(pp-while (zerop (ooccur (car apara) objnm))
		  (pp-cdr para)
		  (pp-cdr apara))
	(setq para (car para))
	(setq unitl (cadddr obj))
	(setq mll (caddr univ))
	(setq mll2 nil)
	(pp-while (not (eq (cond (right (caddar unitl)) (t (cadar unitl)))
			   para))
		  (pp-cdr unitl)
		  (pp-cons (car mll) mll2)
		  (pp-cdr mll))
	(setq ml (car mll))
	(pp-cdr mll)
	(cond ((cdr ml)
	       (cond (right
		      (cond ((not $simp-full)
			     (setq ml (simpl (reverse ml) nil (1+ level))))))
		     (t (setq ml (simpl ml nil (1+ level)))))))
	(setq ml (suuget right (car apara) objnm ml (1+ level)))
	(cond ((null (car ml))
	       (pp-cons (cadr ml) mll)
	       (pp-while mll2 (pp-cons (car mll2) mll) (pp-cdr mll2))
	       (return (list nil (list (list 'factorizer (cadr univ) mll))))))
	(pp-cons (caddr ml) mll)
	(pp-while mll2 (pp-cons (car mll2) mll) (pp-cdr mll2))
	(return (list t (cadr ml) (list (list 'factorizer (cadr univ) mll))))
   zz   (return (list nil ml))))


;; windows

(defun wcat ()
  (prog (tokl stand-alone atokl)
	(cond ((setq stand-alone (eq user-top-level 'wc))
	       (setq user-top-level nil)))
	(rclear)
	(cond ((eq $system-mode 'window) (wc-init)))
	(wc-update-list)
	(w-select $w-command nil)
	(princ "Categorical Programming Language (version 3)")
	(nterpri)
   aa   (setq $w-ll (wc-input $w-command "cpl>" "   >"))
	(setq $rtyi nil)
	(setq $reof nil)
	(setq $ln (- (w-length $w-command) 10))
	(cond ((and $w-ll (eq (car $w-ll) 'token)) (setq tokl (cdr $w-ll)))
	      (t (setq tokl (rtokl 'window))))
   bb	(cond ((null tokl) (go aa))
	      ((eq (car tokl) 'quit)
	       (cond ((eq $system-mode 'window) (wc-end)))
	       (princ "bye")
	       (nterpri)
	       (cond ((or (not stand-alone)
			  (and (cdr tokl) (eq (cadr tokl) 'lisp)))
		      (return nil))
		     (t #+sbcl (sb-ext:quit)
                        #+ccl (ccl:quit)
                        #+clisp (ext:quit)
                        #+ecl (ext:quit)
                        #-(or sbcl ccl clisp ecl) (error "Don't know how to quit"))))
	      ((eq (car tokl) 'edit) (wc-edit (cdr tokl)))
	      ((eq (car tokl) 'let) (maux (cdr tokl)))
	      ((eq (car tokl) 'delete)
	       (odel (cdr tokl)) (wc-update-list))
	      ((eq (car tokl) 'show) (oshow (cdr tokl)))
	      ((memq (car tokl) '(simp eval)) (simp (car tokl) (cdr tokl)))
	      ((eq (car tokl) 'save) (osave (cdr tokl)))
	      ((eq (car tokl) 'load)
	       (oload (cdr tokl)) (wc-update-list))
	      ((eq (car tokl) 'set) (oset (cdr tokl)))
	      ((eq (car tokl) 'read)
	       (oread (cdr tokl)) (wc-update-list))
	      ((eq (car tokl) 'new)
	       (oclear)
	       (princ "All the objects and morphisms are cleared")
	       (nterpri)
	       (wc-update-list))
	      ((eq (car tokl) 'expand) (oexpand (cdr tokl)))
	      ((eq (car tokl) 'help) (wc-help (cdr tokl)))
	      ((eq (car tokl) 'alias) (wc-alias (cdr tokl)))
	      ((eq (car tokl) 'keypad) (wc-keypad (cdr tokl)))
	      ((eq (car tokl) 'scroll) (wc-scroll (cdr tokl)))
	      ((eq (car tokl) 'diagram) (wc-diagram (cdr tokl)))
	      ((setq atokl (assq (car tokl) $aliases))
	       (setq tokl (append (cdr atokl) (cdr tokl)))
	       (go bb))
	      (t (princ "no command: ")
	         (princ (car tokl))
		 (princ "   type `help' for help")
		 (nterpri)))
	(go aa)))

(defun wc-scroll (tokl)
  (prog (n)
	(w-select $w-show t)
	(cond ((null tokl) (wlscroll $w-show 'bottom))
	      ((eq (car tokl) '|-|)
	       (cond ((null (cdr tokl)) (wlscroll $w-show 'top))
		     (t (wlscroll $w-show (- (ogtnum (cadr tokl)))))))
	      (t (wlscroll $w-show (ogtnum (car tokl)))))
	(return t)))

(defun wc-alias (tokl)
  (prog (aliases naliases)
	(cond ((null tokl)
	       (cond ((eq $system-mode 'window)
		      (w-select $w-show t)
		      (wlscroll $w-show 'bottom)
		      (whprinc $w-show "- Aliases -")
		      (nterpri)))
	       (setq aliases $aliases)
	       (pp-while aliases
			 (oprinl (car aliases))
			 (nterpri)
			 (pp-cdr aliases))
	       (return t)))
	(setq aliases $aliases)
	(pp-while (and aliases (not (eq (caar aliases) (car tokl))))
		  (pp-cons (car aliases) naliases)
		  (pp-cdr aliases))
	(cond (aliases (setq $aliases (append naliases (cdr aliases)))))
	(cond ((null (cdr tokl)) (return t)))
	(setq $aliases (cons tokl $aliases))
	(return t)))

(defun wc-keypad (tokl)
  (prog (keypad nkeypad)
	(cond ((null tokl)
	       (cond ((eq $system-mode 'window)
		      (w-select $w-show t)
		      (wlscroll $w-show 'bottom)
		      (whprinc $w-show  "- Keypad -")
		      (nterpri)))
	       (setq keypad $keypad)
	       (pp-while keypad
			 (princ (caar keypad))
			 (princ ": ")
			 (oprinl (cdar keypad))
			 (nterpri)
			 (pp-cdr keypad))
	       (return t)))
	(setq keypad $keypad)
	(pp-while (and keypad (not (eq (caar keypad) (car tokl))))
		  (pp-cons (car keypad) nkeypad)
		  (pp-cdr keypad))
	(cond (keypad (setq $keypad (append nkeypad (cdr keypad)))))
	(cond ((null (cdr tokl)) (return t)))
	(setq $keypad (cons tokl $keypad))
	(return t)))

(defun wc-init ()
  (prog ()
	(setq $system-mode 'window)
	(wraw)
	(setq $w-edit (wmake 5 5 10 40 0))
	(wheading $w-edit "EDIT")
	(setq $w-diagram (wmake 1 1 16 63 20))
	(wheading $w-diagram "DIAGRAM EDITOR")
	(setq $w-show (wmake 1 1 16 63 20))
	(wheading $w-show "SHOW")
	(wscroll $w-show t)
	(setq $w-m-list (wmake 66 1 16 12 5))
	(wheading $w-m-list "MORPHISM")
	(wscroll $w-m-list t)
	(setq $w-o-list (wmake 66 1 16 12 5))
	(wheading $w-o-list "OBJECT")
	(wscroll $w-o-list t)
	(setq $w-command (wmake 1 19 4 77 10))
	(wheading $w-command "COMMAND")
	(wscroll $w-command t)
	(return nil)))

(defun wc-end ()
  (prog ()
	(wcooked)
	(wdelete $w-edit)
	(setq $w-edit nil)
	(wdelete $w-diagram)
	(setq $w-diagram nil)
	(wdelete $w-show)
	(setq $w-show nil)
	(wdelete $w-m-list)
	(setq $w-m-list nil)
	(wdelete $w-o-list)
	(setq $w-o-list nil)
	(wdelete $w-command)
	(setq $w-command nil)
	(cond ($w-help-on (wdelete $w-help)))
	(setq $w-help nil)
	(setq $w-help-on nil)
	(setq $system-mode 'line)
	(return nil)))

(defun w-select (w pull)
	 (cond ((eq $system-mode 'window)
		(cond (pull (wpull w)) (t (wselect w))))))

(defun w-length (w)
  (cond ((eq $system-mode 'window) (wlength w)) (t 80)))

(defun wc-input (w prmpt prmpt2)
  (prog (ll l ch echo fn)
	(setq echo (eq $system-mode 'window))
	(w-select w nil)
   bb	(cond (prmpt (princ prmpt)))
	(setq prmpt prmpt2)
   aa   (setq ch (tyi))
	(cond ((and (<= 32 ch) (< ch 127))
	       (cond (echo (tyo ch)))
	       (setq l (cons ch l)))
	      ((and echo (or (= ch 8) (= ch 127)))
	       (cond (l (setq l (cdr l))
			(tyo 8)
			(tyo 32)
			(tyo 8))))
	      ((and echo (= ch 27))
	       (setq fn (assq (ascii (tyi)) $keypad))
	       (cond ((null fn) (go aa)))
	       (pp-while l (tyo 8) (tyo 32) (tyo 8) (pp-cdr l))
	       (oprinl (cdr fn))
	       (nterpri)
	       (return (cons 'token (cdr fn))))
	      ((or (= ch 13) (= ch 10))
	       (cond (echo (nterpri)))
	       (cond ((and l (= (car l) (rascii |&|)))
		      (setq ll (cons (nreverse (cdr l)) ll))
		      (setq l nil)
		      (go bb)))
	       (return (nreverse (cons (nreverse l) ll)))))
	(go aa)))

(defun wc-edit (tokl)
  (prog (x ok win)
	(cond ((not (setq win (eq $system-mode 'window)))
	       (cond (tokl (princ
			    "You can't modify things unless in window mode")
			   (nterpri)
			   (return nil)))
	       (go aa))
	      ((null tokl) nil)
	      ((eq (car tokl) 'new) (we-new))
	      ((get (car tokl) 'object)
	       (we-put (wc-object (car tokl))))
	      ((setq x (get (car tokl) 'morphism))
	       (cond ((eq (car x) 'auxiliary)
		      (we-put (wc-morph (car tokl) x)))
		     (t (princ "Auxiliary morphism name please")
			(nterpri)
			(return nil))))
	      (t (princ "Object or morphism name please")
		 (nterpri)
		 (return nil)))
   aa   (cond (win (w-select $w-edit t)
		   (cond ((= (wedit $w-edit) 3) (return nil)))
		   (setq $w-ll (we-get))
		   (rclear)
		   (setq tokl (rtokl 'window)))
	      (t (rclear)
		 (setq $rnl t)
		 (setq tokl (rtokl nil))
		 (wc-input nil "" "")))
	(rclear)
	(w-select $w-command nil)
	(cond ((null tokl) (princ "Null input") (nterpri) (return nil))
	      ((or (eq (car tokl) 'right) (eq (car tokl) 'left))
	       (setq ok (object tokl)))
	      ((eq (car tokl) 'let) (setq ok (maux (cdr tokl))))
	      (t (princ "Object or morphism declaration please")
		 (nterpri)
		 (oerrposprint tokl tokl)
		 (go aa)))
	(cond ((null ok) (go aa)))
	(wc-update-list)
	(return t)))

(defun wc-update-list ()
  (prog (ol ml)
	(cond ((not (eq $system-mode 'window)) (return nil)))
	(wclall $w-o-list)
	(setq ol $object)
   aa   (cond (ol (cond ((get (car ol) 'incorrect) (princ "*")))
		  (princ (car ol))
		  (nterpri)
		  (setq ol (cdr ol))
		  (go aa)))
	(wclall $w-m-list)
	(setq ml $morphism)
   bb   (cond ((null ml) (return nil))
	      ((eq (car (get (car ml) 'morphism)) 'auxiliary)
	       (cond ((get (car ml) 'incorrect) (princ "*")))
	       (princ (car ml))
	       (nterpri)))
	(setq ml (cdr ml))
	(go bb)))

(defvar $wc-l nil)
(defvar $wc-ll nil)
(defvar $wc-c 0)

(defun wc-object (objnm)
  (prog (obj l)
	(setq $wc-l nil)
	(setq $wc-c 0)
	(setq $wc-ll nil)
	(setq obj (get objnm 'object))
	(wc-princ (car obj))
	(wc-princ " object ")
	(wc-princ objnm)
	(setq l (cadr obj))
	(cond ((null l) (go bb)))
	(wc-princ (rlpar))
   aa   (wc-princ (car l))
	(setq l (cdr l))
	(cond (l (wc-princ (rcomma)) (go aa)))
	(wc-princ (rrpar))
   bb   (wc-princ " with ")
	(wc-princ (caddr obj))
	(setq l (cadddr obj))
	(cond (l (wc-princ " is")))
	(wc-terpri)
   cc   (cond ((null l) (wc-princ "end object")
			(wc-terpri)
			(return (nreverse $wc-ll))))
	(wc-princ "    ")
	(wc-princ (caar l))
	(wc-princ " : ")
	(wc-pobj (cadar l))
	(wc-princ " -> ")
	(wc-pobj (caddar l))
	(wc-terpri)
	(setq l (cdr l))
	(go cc)))

(defun wc-pobj (o)
  (prog ()
	(cond ((atom o) (wc-princ o) (return nil)))
	(wc-princ (cadr o))
	(setq o (caddr o))
	(cond ((null o) (return nil)))
	(wc-princ (rlpar))
   aa   (wc-pobj (car o))
	(setq o (cdr o))
	(cond (o (wc-princ (rcomma)) (go aa)))
	(wc-princ (rrpar))
	(return nil)))

(defun wc-morph (mn dc)
  (prog ()
	(setq $ln (- (w-length $w-edit) 10))
	(setq $wc-ll nil)
	(setq $wc-l nil)
	(setq $wc-c 0)
	(wc-princ "let ")
	(wc-princ mn)
	(wc-princ " = ")
	(wc-pmorphl (caddr dc))
	(wc-terpri)
	(return (nreverse $wc-ll))))

(defun wc-pmorph (m)
  (progn
   (cond ((> $wc-c $ln) (wc-terpri) (wc-princ "    ")))
   (cond ((eq (car m) 'identity) (wc-princ "id"))
	 ((or (eq (car m) 'unit) (eq (car m) 'auxiliary))
	  (wc-princ (cadr m)))
	 ((eq (car m) 'factorizer)
	  (prog (mll)
	        (wc-princ (cadr m))
	        (setq mll (caddr m))
	        (cond ((null mll) (return nil)))
	        (wc-princ (rlpar))
	   aa   (wc-pmorphl (car mll))
	        (setq mll (cdr mll))
	        (cond ((null mll) (wc-princ (rrpar)) (return nil)))
	        (wc-princ (rcomma))
	        (go aa))))))

(defun wc-pmorphl (ml)
  (cond ((null ml))
	((eq $arrow-dir 'reversed)
	 (cond ((cdr ml) (wc-pmorphl (cdr ml)) (wc-princ (rrcomp))))
	 (wc-pmorph (car ml)))
	(t (wc-pmorph (car ml))
	   (cond ((cdr ml) (wc-princ (rcomp)) (wc-pmorphl (cdr ml)))))))

(defun wc-princ (x)
  (prog (l)
	(setq l (exploden x))
	(setq $wc-l (revapp (exploden x) $wc-l))
	(setq $wc-c (+ $wc-c (length l)))
	(return l)))

(defun wc-terpri ()
  (progn (setq $wc-ll (cons (nreverse $wc-l) $wc-ll))
	 (setq $wc-c 0)
	 (setq $wc-l nil)))

;; help

(defvar $help-message nil)

(defun wc-help (tokl)
  (prog (hm subject)
	(cond ((null tokl) (setq subject 'general))
	      ((eq (car tokl) 'off)
	       (cond ((and (eq $system-mode 'window) $w-help-on)
		      (wdelete $w-help)
		      (setq $w-help-on nil)))
	       (return nil))
	      (t (setq subject (car tokl))))
	(setq hm $help-message)
   aa   (cond ((null hm)
	       (oprinl `("no help for" ,subject))
	       (nterpri)
	       (return nil))
	      ((not (eq (caar hm) subject))
	       (setq hm (cdr hm))
	       (go aa)))
	(setq hm (cadar hm))
	(cond ((eq $system-mode 'window) (wc-help-window hm)))
   bb   (cond ((null hm) (return nil)))
	(princ (car hm))
	(setq hm (cdr hm))
	(cond ((or hm (not (eq $system-mode 'window))) (nterpri)))
	(go bb)))

(defun wc-help-window (msgl)
  (prog (col row l n)
	(cond ($w-help-on (wdelete $w-help)))
	(setq col 4)
	(setq row 0)
	(setq l msgl)
   aa   (cond ((null l) (go bb))
	      ((> (setq n (flatc (car l))) col) (setq col n)))
	(setq l (cdr l))
	(setq row (1+ row))
	(go aa)
   bb   (setq $w-help (wmake (- 70 col) 3 row (1+ col) 0))
	(wheading $w-help "HELP")
	(w-select $w-help nil)
	(setq $w-help-on t)
	(return nil)))

(defun wc-diagram (tokl)
  (prog (name sl ml y)
	(cond ((null tokl) (setq name nil))
	      ((not (eq $system-mode 'window))
	       (cond ((get (car tokl) 'incorrect)
		      (princ "Difinition is incorrect")
		      (nterpri)
		      (return nil)))
	       (setq sl (de-print (car tokl)))
	       (cond ((null sl)
		      (princ "An auxiliary morphism name should be given")
		      (nterpri)
		      (return nil)))
	       (de-display sl 0 0 0 32767 nil)
	       (return t))
	      (t (setq name (car tokl))
		 (cond ((get name 'incorrect)
			(princ "Difinition is incorrect")
			(nterpri)
			(return nil)))))
	(setq ml (dedit $w-diagram name))
	(wselect $w-command)
	(setq name (car ml))
	(setq ml (cdr ml))
	(cond ((null ml) (return nil))
	      ((and (setq y (get name 'morphism))
		    (not (eq (car y) 'auxiliary)))
	       (oprinl `("morphism" ,name "is already defined as" ,(car y)))
	       (nterpri)
	       (return nil))
	      (y (odelm name nil)))
	(setf (get name 'morphism)
		 (cons 'auxiliary
		       (cons '*auxiliary ml)))
	(cond ((oincml (car ml)) (setf (get name 'incorrect) t))
	      (t (remprop name 'incorrect)))
	(cond ((not (memq name $morphism))
	       (setq $morphism (cons name $morphism))))
	(pmobj name (caddr ml) (cadddr ml))
	(princ " defined")
	(nterpri)))

;; bootstrap - load supporting modules if not already loaded
;; (Skip when building standalone executable where all files are pre-loaded)
;; Set *modules-preloaded* to T in build script to skip this
(defvar *modules-preloaded* nil
  "Set to T when building executable with all modules pre-loaded")

(eval-when (:load-toplevel :execute)
  (unless *modules-preloaded*
    (load "wdia")
    (load "wcathelp")
    (load "wmlib")))

(defun wc ()
  (prog (args debug)
	(tyi)
	(cond ((eq user-top-level 'wc)
	       (setq args (command-line-args))
	       (pp-while args
			 (cond ((memq (car args) '(line window))
				(setq $system-mode (car args)))
			       ((eq (car args) 'debug)
				(setq $erflag t)
				(setq debug t)))
			 (pp-cdr args))
	       (cond ((not debug) (cl:proclaim '(optimize (speed 3) (safety 0)))))))
	(wcat)))
