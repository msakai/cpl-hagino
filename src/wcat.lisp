(defmacro pp-inc (var)
  `(setq ,var (1+ ,var)))

(defmacro pp-dec (var)
  `(setq ,var (1- ,var)))

(defmacro pp-cons (item list)
  `(setq ,list (cons ,item ,list)))

(defmacro pp-cdr (list)
  `(setq ,list (cdr ,list)))

(defmacro pp-while (test &body body)
  `(prog () pp-while-label (cond (,test ,@body (go pp-while-label)))))

(defmacro pp-do (&body body)
  (let ((l body) p c vars inits)
    (pp-while l
     (cond ((or (eq (car l) 'until) (eq (car l) 'while))
            (cond ((null (cdr l)) (error 'pp-do))
                  ((eq (car l) 'until) (setq c (cadr l)))
                  (t (setq c `(not ,(cadr l)))))
            (pp-cons `(cond (,c (return))) p)
            (pp-cdr l))
           ((eq (car l) 'var)
            (cond ((or (null (cdr l)) (not (atom (cadr l))))
                   (error 'pp-do)))
            (pp-cons (cadr l) vars))
           ((eq (car l) 'vars)
            (cond ((or (null (cdr l)) (not (consp (cadr l))))
                   (error 'pp-do)))
            (setq vars (append (cadr l) vars)))
           ((eq (car l) 'init)
            (cond ((null (cdr l)) (error 'pp-do)))
            (pp-cons (cadr l) inits))
           (t (pp-cons (car l) p)))
     (pp-cdr l))
    (cons 'prog
          (cons (nreverse vars)
                (nconc (nreverse inits)
                       (cons 'pp-do-label
                             (nconc (nreverse p)
                                    '((go pp-do-label)))))))))

