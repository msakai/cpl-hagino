(defmacro nterpri ()
  '(progn (tyo 13) (terpri)))

;; lexical analyzer

; reading routines

(defvar $rprmpt "| ")
(defvar $rtyi nil)
(defvar $rnl nil)
(defvar $rtok nil)
(defvar $reof nil)
(defvar $ln 70)

(defmacro rascii (ch)
  (car (exploden ch)))

(defmacro rarrow () ''|->|)

(defmacro rcolon () ''|:|)

(defmacro rcomp () ''|.|)

(defmacro rrcomp () ''|\||)

(defmacro rlpar () ''|(|)

(defmacro rrpar () ''|)|)

(defmacro rcomma () ''|,|)

(defmacro requal () ''|=|)

(defmacro rstar () ''|*|)

(defun rtyi (pt)
  (prog (x)
   	(cond ($rtyi (setq x (car $rtyi))
		     (setq $rtyi (cdr $rtyi))
		     (return x))
	      ($reof (return -1)))
	(cond ((and $rnl (null pt) (cl:interactive-stream-p *standard-input*))
               (princ $rprmpt)))
	(cond ((null pt) (setq x (tyi)))
	      ((eq pt 'line) (setq x -1))
	      ((eq pt 'window)
	       (cond ((null $w-ll) (setq x -1))
		     (t (setq $rtyi (car $w-ll))
			(setq $w-ll (cdr $w-ll))
			(setq x 10))))
	      (t (setq x (tyi pt))))
	(setq $reof (< x 0))
	(setq $rnl (= x 10))
	(return x)))

(defmacro rbtyi (x)
  `(setq $rtyi (cons ,x $rtyi)))

(defun rdigit (ch)
  (and (<= (rascii \0) ch) (<= ch (rascii \9))))

(defun rletter (ch)
  (or (and (<= (rascii \A) ch) (<= ch (rascii \Z)))
      (and (<= (rascii \a) ch) (<= ch (rascii \z)))
      (= ch (rascii \!))))

(defun rspecial (ch)
  (or (= ch (rascii \,))
      (= ch (rascii \.))
      (= ch (rascii \)))
      (= ch (rascii \())
      (= ch (rascii \:))
      (= ch (rascii \;))))

(defun rtok (pt)
  (prog (ch chl)
	(cond ($rtok (setq ch (car $rtok))
		     (setq $rtok (cdr $rtok))
		     (return ch)))
   aa   (setq ch (rtyi pt))
	(cond ((< ch 0) (return -1))
	      ((<= ch (rascii \ )) (go aa))
	      ((rspecial ch) (return (ascii ch)))
	      ((rdigit ch) (go cc))
	      ((rletter ch) (go cc)))
   dd   (setq chl (cons ch chl))
	(setq ch (rtyi pt))
	(cond ((and (not (<= ch (rascii \ )))
		    (not (rspecial ch))
		    (not (rdigit ch))
		    (not (rletter ch)))
	       (go dd)))
   ee   (rbtyi ch)
	(return (intern (string-upcase (maknam (reverse chl))) :cpl))
   cc   (setq chl (cons ch chl))
	(setq ch (rtyi pt))
	(cond ((or (rletter ch) (rdigit ch)
		   (= ch (rascii \_))) (go cc)))
	(go ee)))

(defun rtokl (pt)
  (prog (tok tokl)
   aa   (setq tok (rtok pt))
	(cond ((or (eq tok '\;) (eq tok -1)) (return (reverse tokl))))
	(setq tokl (cons tok tokl))
	(go aa)))

(defun rclear ()
  (progn (setq $rtyi nil)
	 (setq $reof nil)
	 (setq $rtok nil)))

;; paser

(defun oread (tokl)
  (prog (fn pt ok sys-fn)
	(cond ((null tokl) (princ "No file name") (nterpri) (return nil)))
	(setq fn (concatl tokl))
	;; Try direct filename first, then system/ directory
	(cond ((probef fn) t)
	      ((progn
	         (setq sys-fn (concat 'system/ fn))
	         (probef sys-fn))
	       (setq fn sys-fn))
	      (t (princ "File dose not exist") (nterpri) (return nil)))
	(rclear)
	(setq pt (fileopen fn "r"))
   aa   (setq tokl (rtokl pt))
	(cond ((null tokl) (setq ok nil))
	      ((or (eq (car tokl) 'right) (eq (car tokl) 'left))
	       (setq ok (object tokl)))
	      ((eq (car tokl) 'let)
	       (setq ok (maux (cdr tokl))))
	      (t (princ "Unexpected input: ")
		 (princ (car tokl))
		 (nterpri)
		 (setq ok nil)))
	(cond (ok (go aa)))
	(close pt)
	(rclear)
	(return nil)))

; paser for objects

(defvar $error nil)
(defvar $errpos nil)
(defvar $object nil)
(defvar $morphism nil)

(defun oerrposprint (tokl etokl)
  (prog (oktokl cnt)
	(cond ((null tokl) (return nil)))
   aa   (cond ((null tokl) (go bb))
	      ((equal tokl etokl) (go bb)))
	(setq oktokl (cons (car tokl) oktokl))
	(setq tokl (cdr tokl))
	(go aa)
   bb   (setq cnt 0)
	(setq tokl nil)
   cc   (cond ((and oktokl (< cnt 5))
	       (setq tokl (cons (car oktokl) tokl))
	       (setq oktokl (cdr oktokl))
	       (setq cnt (1+ cnt))
	       (go cc)))
	(princ "... ")
   dd   (cond (tokl (princ (car tokl))
		    (princ " ")
		    (setq tokl (cdr tokl))
		    (go dd)))
	(princ "??? ")
	(setq cnt 0)
   ee   (cond ((and etokl (< cnt 5))
	       (princ (car etokl))
	       (princ " ")
	       (setq etokl (cdr etokl))
	       (setq cnt (1+ cnt))
	       (go ee)))
	(princ "...")
	(nterpri)))

(defun object (tokl)
  (prog (obj mdl nobj)
	(setq obj (errset (ohead tokl) $erflag))
	(cond ((atom obj) (princ "Syntax error: ")
			  (oprinl $error)
			  (nterpri)
			  (oerrposprint tokl $errpos)
			  (return nil)))
	(setq obj (car obj))
	(cond ((null (setq nobj (odecl (car obj) (cdr obj) nil)))
	       (return nil)))
	(odecl (setq obj (car obj)) nobj t)
	(setq mdl (ofunc obj nobj))
	(cond ((car (cddddr nobj)) (princ (car (cddddr nobj))) (princ " ")))
	(princ (car nobj))
	(princ " object ")
	(princ obj)
	(cond ((null mdl) (go bb)))
	(princ (rlpar))
   aa	(cond ((eq (car mdl) 'covariant) (princ "+"))
	      ((eq (car mdl) 'contravariant) (princ "-"))
	      ((eq (car mdl) 'free) (princ "0"))
	      (t (princ "?")))
	(setq mdl (cdr mdl))
	(cond (mdl (princ (rcomma)) (go aa)))
	(princ (rrpar))
   bb	(princ " defined")
	(nterpri)
	(return t)))

(defun odecl (obj l flg)
  (prog (x y md1 md2 rl dom mdom productive codom para npara)
	(setq rl (car l))
	(cond (flg
	       (cond ((get obj 'object) (odelo obj nil)))
	       (setq $object (cons obj $object))
	       (setf (get obj 'object) l)
	       (cond ((oinco obj) (setf (get obj 'incorrect) t))))
	      ((and (setq y (get obj 'morphism))
		    (not (eq (cadr y) obj)))
	       (oprinl `("object" ,obj "is already declared as a morphism"))
	       (go zz)))
	(setq x (caddr l))
	(cond (flg (setf (get x 'morphism) `(factorizer ,obj))
		   (setq $morphism (cons x $morphism)))
	      ((and (setq y (get x 'morphism)) (not (eq (cadr y) obj)))
	       (oprinl `("factorizer" ,x "is used in" ,(cadr y)))
	       (go zz)))
	(setq x (cadddr l))
	(cond ((eq rl 'right) (setq productive 'productive)
			      (setq mdom '("domain" "productive")))
	       (t (setq productive 'coproductive)
		  (setq mdom '("codomain" "coproductive"))))
	(setq para (cadr l))
   aa   (cond ((null x)
	       (cond (flg (return nil))
		     (t (return (append l (list productive))))))
	      (flg (setf (get (caar x) 'morphism)
			    `(unit ,obj ,(cadar x) ,(caddar x)))
		   (setq $morphism (cons (caar x) $morphism))
		   (setq x (cdr x))
		   (go aa))
	      ((and (setq y (get (caar x) 'morphism))
		    (not (eq (cadr y) obj)))
	       (oprinl `("unit" ,(caar x) "is used in" ,(cadr y)))
	       (go zz))
	      ((eq rl 'right) (setq dom (cadar x)) (setq codom (caddar x)))
	      (t (setq dom (caddar x)) (setq codom (cadar x))))
	(cond ((and productive (atom codom) (memq codom para))
	       (cond ((memq codom npara) (setq productive nil))
		     (t (pp-cons codom npara))))
	      (t (setq productive nil)))
	(cond ((not (equal (ooccur dom obj) 1))
	       (oprinl `(,obj
			 "should occur once in"
			 ,(car mdom)
			 "of"
			 ,(caar x)))
	       (go zz))
	      ((not (oprodchk dom obj rl))
	       (oprinl `(,obj
			 "should occur inside"
			 ,(cadr mdom)
			 "objects"
			 "in"
			 ,(car mdom)
			 "of"
			 ,(caar x)))
	       (go zz)))
	(setq md1 (ofunmod (cadar x) obj))
	(setq md2 (ofunmod (caddar x) obj))
	(cond ((or (eq md1 'fix) (eq md2 'fix))
	       (oprinl `(,obj "occurs inconsistently in" ,(caar x)))
	       (go zz))
	      ((or (eq md1 'contravariant) (eq md2 'contravariant))
	       (oprinl `(,obj "must not occur contravariantly in " ,(caar x)))
	       (go zz))
	      ((and (eq md1 'free) (eq md2 'free))
	       (oprinl `(,(caar x) "does not depend on" ,obj))
	       (go zz)))
	(setq x (cdr x))
	(go aa)
   zz	(nterpri)
	(return nil)))

(defun ooccur (dom obj)
  (prog (l sum)
	(cond ((eq dom obj) (return 1))
	      ((atom dom) (return 0)))
	(setq l (caddr dom))
	(setq sum 0)
   aa   (cond ((null l) (return sum)))
	(setq sum (+ sum (ooccur (car l) obj)))
	(setq l (cdr l))
	(go aa)))

(defun oprodchk (dom obj rl)
  (prog (l)
	(cond ((eq dom obj) (return t))
	      ((not (equal (ooccur dom obj) 1)) (return nil)))
	(setq l (get (cadr dom) 'object))
	(cond ((null l) (return nil))
	      ((not (eq (car l) rl)) (return nil)))
	(cond ((or (and (eq rl 'right) (not (eq (car (cddddr l)) 'productive)))
		   (and (eq rl 'left)
			(not (eq (car (cddddr l)) 'coproductive))))
	       (return nil)))
	(setq l (caddr dom))
	(pp-while (and l (not (equal (ooccur (car l) obj) 1))) (pp-cdr l))
	(cond ((null l) (return nil)))
	(return (oprodchk (car l) obj rl))))

(defun oprinl (msgl)
  (cond ((null msgl) nil)
	((atom msgl) (princ msgl))
	(t (princ (car msgl))
	   (cond ((cdr msgl) (princ " ")))
	   (oprinl (cdr msgl)))))

(defun oerror (emsg tokl)
  (progn (setq $error emsg) (setq $errpos tokl) (error 0)))

(defun oeq (tokl tok)
  (cond ((null tokl) (oerror `("expecting" ,tok)  tokl))
	(t (eq (car tokl) tok))))

(defun ocheck (tokl tok)
  (cond ((or (null tokl) (not (eq (car tokl) tok)))
	 (oerror `("expecting" ,tok) tokl))))

(defmacro onext (&optional var)
  (cond (var `(setq ,var (cdr ,var)))
	(t '(setq tokl (cdr tokl)))))

(defun onmchk (tokl msg)
  (cond ((null tokl) (oerror `("no" ,msg "name") nil))
	((memq (car tokl) '(with end is it
 	                   \) \( \: \-\> \, \.))
	 (oerror `("illegal" ,msg "name") tokl))
	(t (car tokl))))

(defun ohead (tokl)
  (prog (name rl argl univ unit unitl)
	(cond ((oeq tokl 'right) (setq rl 'right))
	      ((oeq tokl 'left) (setq rl 'left))
	      (t (oerror "right or left expected" tokl)))
	(onext)
	(ocheck tokl 'object)
	(onext)
	(setq name (onmchk tokl "object"))
	(onext)
	(cond ((not (oeq tokl (rlpar))) (go bb)))
   aa   (onext)
	(setq argl (cons (onmchk tokl "parameter") argl))
	(cond ((memq (car argl) (cdr argl))
	       (oerror "duplicate parameters" tokl)))
	(onext)
	(cond ((oeq tokl (rcomma)) (go aa)))
	(ocheck tokl (rrpar))
	(onext)
	(setq argl (reverse argl))
	(cond ((memq name argl) (oerror "name confusion in parameters" tokl)))
   bb   (ocheck tokl 'with)
	(onext)
	(setq univ (onmchk tokl "factorizer"))
	(onext)
	(cond ((oeq tokl 'is) (onext)))
   cc   (cond ((oeq tokl 'end) (go dd)))
	(setq unit (ounit tokl name argl))
	(setq tokl (cadr unit))
	(cond ((assoc (caar unit) unitl)
	       (oerror "duplicate unit name" tokl))
	      ((eq univ (caar unit))
	       (oerror "unit name equal to factorizer" tokl)))
	(setq unitl (cons (car unit) unitl))
	(go cc)
   dd   (onext)
	(setq unitl (reverse unitl))
	(ocheck tokl 'object)
	(onext)
	(cond (tokl (oerror "somthing after end" tokl)))
	(return (list name rl argl univ unitl))))

(defun ounit (tokl obj argl)
  (prog (name domain codomain)
	(setq name (onmchk tokl "unit"))
	(onext)
	(ocheck tokl (rcolon))
	(onext)
	(setq domain (odom tokl (cons obj argl) nil nil))
	(setq tokl (cadr domain))
	(setq domain (car domain))
	(ocheck tokl (rarrow))
	(onext)
	(setq codomain (odom tokl (cons obj argl) nil nil))
	(setq tokl (cadr codomain))
	(setq codomain (car codomain))
	(return (list (list name domain codomain) tokl))))

(defun odom (tokl argl tvar tvl)
  (prog (name para fpara apara oobj)
	(cond ((and tvar (eq (car tokl) (rstar)))
	       (onext)
	       (setq name (onmchk tokl "parameter"))
	       (onext)
	       (setq name (intern (concat (rstar) name)))
	       (setq para (assq name tvl))
	       (cond ((null para)
		      (setq para (car (mnewvar '(*a))))
		      (return (list para tokl (cons (list name para) tvl))))
		     (t (return (list (cadr para) tokl tvl))))))
	(setq name (onmchk tokl "object"))
	(onext)
	(cond ((memq name argl)
	       (cond (tvar (return (list name tokl tvl)))
		     (t (return (list name tokl))))))
	(setq oobj (get name 'object))
	(cond ((null oobj) (oerror `("undefined object" ,name) tokl)))
	(setq fpara (cadr oobj))
	(cond ((null fpara) (go bb)))
	(ocheck tokl (rlpar))
   aa	(onext)
	(setq para (odom tokl argl tvar tvl))
	(setq tokl (cadr para))
	(cond (tvar (setq tvl (caddr para))))
	(pp-cons (car para) apara)
	(pp-cdr fpara)
	(cond (fpara (ocheck tokl (rcomma)) (go aa)))
	(ocheck tokl (rrpar))
	(onext)
	(setq apara (nreverse apara))
   bb   (cond (tvar (return (list (list 'object name apara) tokl tvl)))
	      (t (return (list (list 'object name apara) tokl))))))

; functor associated with objects

(defun ofunc (objnm obj)
  (prog (rl ul mdl argl argmdl x)
	(setq rl (car obj))
	(setq ul (cadddr obj))
   aa	(cond ((null ul) (go bb))
	      ((eq rl 'right)
	       (setq mdl (ofunmoda (cadar ul) 'contravariant mdl))
	       (setq mdl (ofunmoda (caddar ul) 'covariant mdl)))
	      (t (setq mdl (ofunmoda (cadar ul) 'covariant mdl))
		 (setq mdl (ofunmoda (caddar ul) 'contravariant mdl))))
	(setq ul (cdr ul))
	(go aa)
   bb	(setq argl (cadr obj))
   cc   (cond ((null argl) (go dd)))
	(setq x (assoc (car argl) mdl))
	(cond ((null x) (setq x 'free)) (t (setq x (cdr x))))
	(setq argmdl (cons x argmdl))
	(setq argl (cdr argl))
	(go cc)
   dd	(setq argmdl (reverse argmdl))
	(setf (get objnm 'morphism) (list 'functor objnm nil argmdl))
	(return argmdl)))

(defun ofunmod (o para)
  (prog (ml x)
	(setq ml (ofunmoda o 'covariant nil))
	(setq x (assoc para ml))
	(cond ((null x) (return 'free))
	      (t (return (cdr x))))))

(defun ofunmoda (o cm ml)
  (cond ((atom o) (ofunmodaa o cm ml))
	(t (prog (ml1 argl)
		 (setq ml1 (cadddr (get (cadr o) 'morphism)))
		 (setq argl (caddr o))
	    aa   (cond ((null ml1) (return ml))
		       ((or (eq cm 'fix) (eq (car ml1) 'fix))
		        (setq ml (ofunmoda (car argl) 'fix ml)))
		       ((or (eq cm 'free) (eq (car ml1) 'free)) nil)
		       ((eq cm 'covariant)
		        (setq ml (ofunmoda (car argl) (car ml1) ml)))
		       ((eq (car ml1) 'covariant)
			(setq ml (ofunmoda (car argl) 'contravariant ml)))
		       (t (setq ml (ofunmoda (car argl) 'covariant ml))))
		 (setq ml1 (cdr ml1))
		 (setq argl (cdr argl))
		 (go aa)))))

(defun ofunmodaa (o cm ml)
  (cond ((null ml) (list (cons o cm)))
	((eq (caar ml) o)
	 (cond ((eq cm 'free) ml)
	       ((eq (cdar ml) 'free) (cons (cons o cm) (cdr ml)))
	       ((eq cm (cdar ml)) ml)
	       (t (cons (cons o 'fix) (cdr ml)))))
	(t (cons (car ml) (ofunmodaa o cm (cdr ml))))))

; paser for morphisms

(defvar $var 0)
(defvar $avar nil)

(setf (get 'id 'morphism) '(identity *identity *a *a))

(defun maux (tokl)
  (prog (m y)
	(setq m (errset (mauxp tokl) $erflag))
	(cond ((atom m) (princ "Syntax error: ")
			(oprinl $error)
			(nterpri)
			(oerrposprint tokl $errpos)
			(return nil)))
	(setq m (car m))
	(cond ((and (setq y (get (car m) 'morphism))
		    (not (eq (car y) 'auxiliary)))
	       (oprinl `("morphism" ,(car m) "is already defined as" ,(car y)))
	       (nterpri)
	       (return nil))
	      (y (odelm (car m) nil)))
	(setf (get (car m) 'morphism)
		 (cons 'auxiliary
		       (cons '*auxiliary (cdr m))))
	(cond ((oincml (cadr m)) (setf (get (car m) 'incorrect) t))
	      (t (remprop (car m) 'incorrect)))
	(cond ((not (memq (car m) $morphism))
	       (setq $morphism (cons (car m) $morphism))))
	(pmobj (car m) (cadddr m) (car (cddddr m)))
	(princ " defined")
	(nterpri)
	(return t)))

(defun mauxp (tokl)
  (prog (mn m dom codom vl avl)
	(setq mn (onmchk tokl "morphism"))
	(onext)
	(or (oeq tokl 'be) (ocheck tokl (requal)))
	(onext)
	(setq m (morph0 tokl nil))
	(return (cons mn m))))

(defun morph0 (tokl expand)
  (prog (m vl avl dom codom)
	(setq $var 0)
	(setq m (morph tokl nil expand))
	(cond ((cadddr m) (oerror `(,(rcomp) "expected") tokl)))
	(cond ((not (equal $var 0))
	       (setq vl (mgetvo (cadr m) (mgetvo (caddr m) nil)))
	       (setq $avar nil)
	       (setq avl (mnewvara vl nil))
	       (setq vl (mpair vl avl))))
	(cond ((null vl) (setq dom (cadr m))
			 (setq codom (caddr m))
			 (setq m (car m)))
	      (t (setq dom (msubsto (cadr m) vl))
		 (setq codom (msubsto (caddr m) vl))
		 (setq m (car m))))
	(return (list m avl dom codom))))

(defun morph (tokl tvl expand)
  (prog (obj x y vl nm dc m ml dom codom)
	(cond ((null tokl) (oerror "illegal end" nil)))
	(setq nm (car tokl))
	(onext)
	(setq dc (get nm 'morphism))
	(cond ((null dc) (oerror `("no morphism" ,nm) tokl))
	      ((eq (car dc) 'identity)
	       (cond ((or (null tokl) (not (eq (car tokl) (rlpar))))
		      (setq dom (car (mnewvar '(*a)))))
		     (t (onext)
			(setq dom (odom tokl nil t tvl))
			(setq tvl (caddr dom))
			(setq tokl (cadr dom))
			(setq dom (car dom))
			(ocheck tokl (rrpar))
			(onext)))
	       (setq m (list (list 'identity)))
	       (setq codom dom))
	      ((eq (car dc) 'unit)
	       (setq obj (get (cadr dc) 'object))
	       (setq x (cadr obj))
	       (setq vl (mnewvar x))
	       (setq y (list 'object (cadr dc) vl))
	       (setq vl (cons (list (cadr dc) y) (mpair x vl)))
	       (setq m (list (list 'unit nm)))
	       (setq x (cdr (assoc nm (cadddr obj))))
	       (setq dom (msubsto (car x) vl))
	       (setq codom (msubsto (cadr x) vl)))
	      ((eq (car dc) 'factorizer)
	       (setq dc (muniv nm (cadr dc) tokl tvl expand))
	       (setq m (list (car dc)))
	       (setq dom (cadr dc))
	       (setq codom (caddr dc))
	       (setq tokl (cadddr dc))
	       (setq tvl (car (cddddr dc))))
	      ((eq (car dc) 'auxiliary)
	       (setq vl (mnewvar (cadddr dc)))
	       (cond (expand (setq m (caddr dc)))
		     (t (setq m (list (list 'auxiliary nm)))))
	       (cond ((null vl) (setq dom (car (cddddr dc)))
				(setq codom (cadr (cddddr dc))))
		     (t (setq vl (mpair (cadddr dc) vl))
	      		(setq dom (msubsto (car (cddddr dc)) vl))
	       		(setq codom (msubsto (cadr (cddddr dc)) vl)))))
	      ((eq (car dc) 'functor)
	       (setq dc (mfun nm (cadddr dc) tokl tvl expand))
	       (setq m (car dc))
	       (setq dom (cadr dc))
	       (setq codom (caddr dc))
	       (setq tokl (cadddr dc))
	       (setq tvl (car (cddddr dc))))
	      (t (oerror "strange morphism" tokl)))
	(cond ((or (null tokl)
		   (and (not (eq (car tokl) (rcomp)))
			(not (eq (car tokl) (rrcomp)))))
	       (return (list m dom codom tokl tvl)))
	      ((eq (car tokl) (rrcomp))
	       (onext)
	       (setq ml (morph tokl tvl expand))
	       (setq vl (munify codom (cadr ml)))
	       (setq m (mcomp (car ml) m))
	       (setq dom (msubsto dom vl))
	       (setq codom (msubsto (caddr ml) vl)))
	      (t (onext)
		 (setq ml (morph tokl tvl expand))
		 (setq vl (munify dom (caddr ml)))
		 (setq m (mcomp m (car ml)))
		 (setq dom (msubsto (cadr ml) vl))
		 (setq codom (msubsto codom vl))))
	(return (list m dom codom (cadddr ml) (car (cddddr ml))))))

(defun muniv (univ objnm tokl tvl expand)
  (prog (m rl obj para argl unitl dom codom dom1 codom1 vl nv o oo)
	(setq obj (get objnm 'object))
	(setq rl (car obj))
	(setq para (cons objnm (cadr obj)))
	(setq unitl (mapcar 'cdr (cadddr obj)))
	(setq nv (mnewvar para))
	(setq vl (mpair para nv))
	(setq unitl (msubstoll unitl vl))
	(setq o (list 'object objnm (cdr nv)))
	(setq oo (car nv))
	(cond ((eq rl 'right) (setq dom oo) (setq codom o))
	      (t (setq dom o) (setq codom oo)))
	(cond ((null unitl)
	       (return (list (list 'factorizer univ argl)
			     dom
			     codom
			     tokl
			     tvl))))
	(ocheck tokl (rlpar))
   aa   (onext)
	(setq m (morph tokl tvl expand))
	(setq tvl (car (cddddr m)))
	(setq tokl (cadddr m))
	(setq dom1 (cadr m))
	(setq codom1 (caddr m))
	(setq m (car m))
	(setq vl (munify dom1 (caar unitl)))
	(setq codom1 (msubsto codom1 vl))
	(setq unitl (msubstoll unitl vl))
	(setq dom (msubsto dom vl))
	(setq codom (msubsto codom vl))
	(setq o (msubsto o vl))
	(setq oo (msubsto oo vl))
	(setq vl (munify codom1 (cadar unitl)))
	(setq argl (cons m argl))
	(setq unitl (msubstoll (cdr unitl) vl))
	(setq dom (msubsto dom vl))
	(setq codom (msubsto codom vl))
	(setq o (msubsto o vl))
	(setq oo (msubsto oo vl))
	(cond (unitl (ocheck tokl (rcomma)) (go aa)))
	(ocheck tokl (rrpar))
	(onext)
	(return (list (list 'factorizer univ (reverse argl))
		      dom
		      codom
		      tokl
		      tvl))))

(defun mfun (mn mdl tokl tvl expand)
  (prog (para para1 ml m dom codom)
	(cond ((null mdl)
	       (setq dom (list 'object mn nil))
	       (return (list (list (list 'identity)) dom dom tokl tvl))))
	(ocheck tokl (rlpar))
	(setq para (setq para1 (cadr (get mn 'object))))
   aa   (onext)
	(setq m (morph tokl tvl expand))
	(setq dom (cadr m))
	(setq codom (caddr m))
	(setq tokl (cadddr m))
	(setq tvl (car (cddddr m)))
	(setq m (car m))
	(setq ml (cons (list (car para) m dom codom) ml))
	(cond ((and (eq (car mdl) 'fix) (not (equal m `((identity)))))
	       (oerror `("argument error for" ,mn) tokl)))
	(setq mdl (cdr mdl))
	(setq para (cdr para))
	(cond (mdl (ocheck tokl (rcomma)) (go aa)))
	(ocheck tokl (rrpar))
	(onext)
	(setq ml (mfungt (list 'object mn para1) ml))
	(return (list (car ml) (cadr ml) (caddr ml) tokl tvl))))

(defun mfungt (o argl)
  (prog (objnm obj fargl nargl unitl rl para apara bpara f mdl unit mll oa ob
	       dom codom)
	(cond ((atom o) (return (cdr (assoc o argl)))))
	(setq objnm (cadr o))
	(setq obj (get objnm 'object))
	(setq mdl (cadddr (get objnm 'morphism)))
	(setq para (cadr obj))
	(setq fargl (caddr o))
	(setq rl (car obj))
   aa   (cond ((null para) (go bb)))
	(setq f (mfungt (car fargl) argl))
	(setq nargl (cons (cons (car para) f) nargl))
	(cond ((eq (car mdl) 'contravariant)
	       (setq apara (cons (caddr f) apara))
	       (setq bpara (cons (cadr f) bpara)))
	      (t (setq apara (cons (cadr f) apara))
		 (setq bpara (cons (caddr f) bpara))))
	(setq para (cdr para))
	(setq fargl (cdr fargl))
	(go aa)
   bb	(setq unitl (cadddr obj))
	(setq apara (list 'object objnm (reverse apara)))
	(setq bpara (list 'object objnm (reverse bpara)))
	(cond ((eq rl 'right) (setq oa apara) (setq ob bpara))
	      (t (setq oa bpara) (setq ob apara)))
	(setq nargl (cons (list objnm (list (list 'identity)) oa oa)
			   nargl))
   cc   (cond ((null unitl) (go dd)))
	(setq dom (mfungt (cadar unitl) nargl))
	(setq codom (mfungt (caddar unitl) nargl))
	(setq unit (list 'unit (caar unitl)))
	(setq mll (cons (mcomp (car codom) (mcomp (list unit) (car dom)))
		         mll))
	(setq unitl (cdr unitl))
	(go cc)
   dd   (return (list (list (list 'factorizer (caddr obj) (reverse mll)))
		      apara
		      bpara))))

(defun mnewvar (ovar)
  (cond ((null ovar) nil)
	(t (cons (list '*var (setq $var (1+ $var)))
	         (mnewvar (cdr ovar))))))

(defun mpair (x y)
  (cond ((null x) nil)
	(t (cons (list (car x) (car y)) (mpair (cdr x) (cdr y))))))

(defun msubsto (o vl)
  (prog (x)
	(setq x (assoc o vl))
	(cond (x (return (cadr x)))
	      ((not (eq (car o) 'object)) (return o)))
	(return (list 'object (cadr o) (msubstol (caddr o) vl)))))

(defun msubstol (ol vl)
  (cond ((null ol) nil)
	(t (cons (msubsto (car ol) vl) (msubstol (cdr ol) vl)))))

(defun msubstoll (oll vl)
  (cond ((null oll) nil)
	(t (cons (msubstol (car oll) vl) (msubstoll (cdr oll) vl)))))

(defun msubstvl (vl svl)
  (cond ((null vl) nil)
	(t (cons (list (caar vl) (msubsto (cadar vl) svl))
		 (msubstvl (cdr vl) svl)))))

(defun munify (o1 o2)
  (cond ((atom o1) (eq o1 o2))
	((eq (car o1) '*var) (list (list o1 o2)))
	((eq (car o2) '*var) (list (list o2 o1)))
	((not (eq (cadr o1) (cadr o2))) (oerror "domains incompatible" nil))
	(t (prog (vl vl1)
		 (setq o1 (caddr o1))
		 (setq o2 (caddr o2))
	    aa   (cond ((null o1) (return vl)))
		 (setq vl1 (munify (car o1) (car o2)))
		 (setq o1 (msubstol (cdr o1) vl1))
		 (setq o2 (msubstol (cdr o2) vl1))
		 (setq vl (msubstvl vl vl1))
		 (setq vl (append vl1 vl))
		 (go aa)))))

(defun mgetvo (o vl)
  (cond ((atom o) vl)
	((eq (car o) '*var)
	 (cond ((member o vl) vl) (t (cons o vl))))
	(t (mgetvol (caddr o) vl))))

(defun mgetvol (ol vl)
  (cond ((null ol) vl)
	(t (mgetvo (car ol) (mgetvol (cdr ol) vl)))))

(defun mnewvara (vl old)
  (prog (rv alf dec l nv)
	(cond ($avar (setq alf (car $avar)) (setq dec (cadr $avar)))
	      (t (setq alf (rascii a)) (setq dec (rascii 0))))
	(pp-while vl
		  (cond ((equal dec (rascii 0)) (setq l (list alf)))
			(t (setq l (list alf dec))))
		  (setq nv (implode (cons (rascii *) l)))
		  (cond ((not (memq nv old)) (pp-cons nv rv) (pp-cdr vl)))
		  (pp-inc alf)
		  (cond ((> alf (rascii z))
			 (setq alf (rascii a))
			 (pp-inc dec))))
	(setq $avar (list alf dec))
	(return rv)))

(defun mcomp (ml1 ml2)
  (cond ((null ml1) ml2)
	(t (mcomp1 (car ml1) (mcomp (cdr ml1) ml2)))))

(defun mcomp1 (m ml)
  (cond ((null ml) (list m))
	((eq (car m) 'identity) ml)
	((eq (caar ml) 'identity) (mcomp1 m (cdr ml)))
	(t (cons m ml))))

;; print routines

(defun pmobj (mn dom codom)
  (progn (princ mn)
	 (princ " : ")
	 (pobj dom)
	 (princ " -> ")
	 (pobj codom)))

(defun pobj (o)
  (prog ()
	(cond ((atom o) (princ o) (return nil)))
	(princ (cadr o))
	(setq o (caddr o))
	(cond ((null o) (return nil)))
	(princ (rlpar))
   aa   (pobj (car o))
	(setq o (cdr o))
	(cond (o (princ (rcomma)) (go aa)))
	(princ (rrpar))
	(return nil)))

(defun pmorph (m lvl)
  (progn
   (cond ((> (nwritn) $ln) (nterpri) (princ "    ")))
   (cond ((zerop lvl) (princ `|&|))
	 ((eq (car m) 'identity) (princ "id"))
	 ((or (eq (car m) 'unit) (eq (car m) 'auxiliary)) (princ (cadr m)))
	 ((eq (car m) 'factorizer)
	  (prog (mll)
	        (princ (cadr m))
	        (setq mll (caddr m))
	        (cond ((null mll) (return nil)))
	        (princ (rlpar))
	   aa   (pmorphl (car mll) (1- lvl))
	        (setq mll (cdr mll))
	        (cond ((null mll) (princ (rrpar)) (return nil)))
	        (princ (rcomma))
	        (go aa)))
	 (t (oerror "strange morphism" nil)))))

(defun pmorphl (ml lvl)
  (cond ((null ml) (oerror "strange morphism" nil))
	((eq $arrow-dir 'reverse)
	 (cond ((cdr ml) (pmorphl (cdr ml) lvl) (princ (rrcomp))))
	 (pmorph (car ml) lvl))
	(t (pmorph (car ml) lvl)
	   (cond ((cdr ml) (princ (rcomp)) (pmorphl (cdr ml) lvl))))))

(defun oshow (tokl)
  (prog (ml dom codom)
	(cond ((null tokl) (princ "missing name") (nterpri) (return nil))
	      ((eq (car tokl) 'object) (return (oshow1 (cdr tokl))))
	      ((eq (car tokl) 'morphism) (return (oshow2)))
	      ((and (null (get (car tokl) 'morphism))
		    (get (car tokl) 'object))
	       (return (oshow1 tokl))))
	(setq $var 0)
	(setq ml (errset (morph0 tokl t) $erflag))
	(cond ((atom ml) (princ "Syntax error: ")
			 (oprinl $error)
			 (nterpri)
			 (oerrposprint tokl $errpos)
			 (return nil)))
	(setq dom (caddar ml))
	(setq codom (car (cdddar ml)))
	(setq ml (caar ml))
	(cond ((eq $system-mode 'window)
	       (w-select $w-show t)
	       (wlscroll $w-show 'bottom)
	       (whprinc $w-show "- Show Morphism -")
	       (nterpri)))
	(setq $ln (- (w-length $w-show) 10))
	(pmorphl ml -1)
	(nterpri)
	(princ "    : ")
	(pobj dom)
	(princ " -> ")
	(pobj codom)
	(nterpri)
	(return t)))

(defun oshow1 (tokl)
  (prog (obj objnm l iol ol)
	(cond ((eq $system-mode 'window)
	       (wpull $w-o-list)
	       (w-select $w-command nil))
	      ((null tokl)
	       (cond ((null (setq ol $object))
		      (princ "no objecs declared"))
		     (t (princ "objects: ")
			(oprinl (reverse (setq ol $object)))))
	       (nterpri)
	       (pp-while ol
			 (cond ((get (car ol) 'incorrect)
				(pp-cons (car ol) iol)))
			 (pp-cdr ol))
	       (cond (iol (princ "reparse need: ")
			  (oprinl iol)
			  (nterpri)))))
	(cond ((null tokl) (return t)))
	(setq objnm (car tokl))
	(setq obj (get objnm 'object))
	(cond ((null obj) (oprinl `("object" ,objnm "does not exist"))
			  (nterpri)
			  (return nil)))
	(cond ((eq $system-mode 'window)
	       (w-select $w-show t)
	       (wlscroll $w-show 'bottom)
	       (whprinc $w-show "- Show Object -")
	       (nterpri)))
	(setq $ln (- (w-length $w-show) 10))
	(princ (car obj))
	(princ " object ")
	(princ objnm)
	(setq l (cadr obj))
	(cond (l (princ (rlpar))
		 (princ (car l))
		 (pp-cdr l)
		 (pp-while l (princ (rcomma)) (princ (car l)) (pp-cdr l))
		 (princ (rrpar))))
	(princ " with ")
	(princ (caddr obj))
	(setq l (cadddr obj))
	(cond (l (princ " is")))
	(nterpri)
	(pp-while l
		  (princ "    ")
		  (pmobj (caar l) (cadar l) (caddar l))
		  (nterpri)
		  (pp-cdr l))
	(princ "end object")
	(nterpri)))

(defun oshow2 ()
  (prog (m x unit univ aux im)
	(cond ((null (setq m $morphism))
	       (princ "no morphisms declared")
	       (nterpri)
	       (return t))
	      ((eq $system-mode 'window)
	       (wpull $w-m-list)
	       (w-select $w-show t)
	       (wlscroll $w-show 'bottom)
	       (whprinc $w-show "- Morphisms -")
	       (nterpri)))
   aa	(cond ((null m) (go bb))
	      ((null (setq x (get (car m) 'morphism))) nil)
	      ((eq (setq x (car x)) 'unit) (pp-cons (car m) unit))
	      ((eq x 'factorizer) (pp-cons (car m) univ))
	      ((eq x 'auxiliary)
	       (pp-cons (car m) aux)
	       (cond ((get (car m) 'incorrect) (pp-cons (car m) im)))))
	(setq m (cdr m))
	(go aa)
   bb	(cond (unit (princ "units: ") (oprinl unit) (nterpri)))
	(cond (univ (princ "factorizers: ") (oprinl univ) (nterpri)))
	(cond (aux (princ "auxiliaries: ") (oprinl aux) (nterpri)))
	(cond (im (princ "reparse need: ") (oprinl im) (nterpri)))
	(return t)))

(defun osave (tokl)
  (prog (l fn port)
	(cond ((null tokl) (princ "no file name") (nterpri) (return nil)))
	(setq fn (concatl tokl))
	(setq port (fileopen fn "w"))
	(print `(setq $object (quote ,$object)) port)
	(terpri port)
	(print `(setq $morphism (quote ,$morphism)) port)
	(terpri port)
	(setq l (reverse $object))
   aa   (cond ((null l) (go bb)))
	(print `(setf (get ',(car l) 'object) ',(get (car l) 'object)) port)
	(terpri port)
	(print `(setf (get ',(car l) 'morphism) ',(get (car l) 'morphism)) port)
	(terpri port)
	(setq l (cdr l))
	(go aa)
   bb	(setq l (reverse $morphism))
   cc	(cond ((null l) (go dd)))
	(print `(setf (get ',(car l) 'morphism) ',(get (car l) 'morphism)) port)
	(terpri port)
	(setq l (cdr l))
	(go cc)
   dd   (print `(setq $aliases (quote ,$aliases)) port)
	(terpri port)
	(print `(setq $keypad (quote ,$keypad)) port)
	(terpri port)
	(close port)
	(princ "saved")
	(nterpri)
	(return t)))

(defun oload (tokl)
  (prog (fn x pt)
	(cond ((null tokl) (princ "no file name") (nterpri) (return nil)))
	(setq fn (concatl tokl))
	(cond ((null (probef fn)) (oprinl `("file" ,fn "does not exist"))
				  (nterpri)
				  (return nil)))
	(oclear)
	(setq pt (fileopen fn "r"))
   aa   (setq x (read pt))
	(cond ((null x) (close pt) (return t)))
	(eval x)
	(go aa)))

(defun oclear ()
  (prog (l)
	(setq l $object)
	(setq $object nil)
   aa   (cond ((null l) (go bb)))
	(remprop (car l) 'object)
	(remprop (car l) 'morphism)
	(remprop (car l) 'incorrect)
	(setq l (cdr l))
	(go aa)
   bb   (setq l $morphism)
	(setq $morphism nil)
   cc	(cond ((null l) (return t)))
	(remprop (car l) 'morphism)
	(remprop (car l) 'incorrect)
	(setq l (cdr l))
	(go cc)))

; trace

(defvar $trace nil)
(defvar $tplvl 2)

(defun oset (tokl)
  (cond ((null tokl)
	 (cond ((eq $system-mode 'window)
		(w-select $w-show t)
		(wlscroll $w-show 'bottom)
		(whprinc $w-show "- Flags -")
		(nterpri)))
	 (princ "simplification mode: ")
	 (princ $simp-mode)
	 (nterpri)
	 (princ "trace ")
	 (cond ($trace (princ "on")) (t (princ "off")))
	 (nterpri)
	 (princ "trace print depth ")
	 (princ $tplvl)
	 (nterpri)
	 (cond ((eq $system-mode 'window) (princ "window mode"))
	       (t (princ "line input mode")))
	 (nterpri)
	 (cond ((eq $arrow-dir 'normal) (princ "print arrow normal"))
	       (t (princ "print arrow reversed")))
	 (nterpri))
	((or (eq (car tokl) 'simp) (eq (car tokl) 'eval))
	 (cond ((or (null (cdr tokl)) (eq (cadr tokl) 'lazy))
		(setq $simp-mode 'lazy))
	       (t (setq $simp-mode 'full))))
	((eq (car tokl) 'window)
	 (cond ((or (null (cdr tokl)) (eq (cadr tokl) 'on))
		(cond ((not (eq $system-mode 'window))
		       (wc-init)
		       (wc-update-list))))
	       ((eq $system-mode 'window) (wc-end))))
	((eq (car tokl) 'trace)
	 (setq $trace (or (null (cdr tokl)) (eq (cadr tokl) 'on))))
	((eq (car tokl) 'print)
	 (cond ((null (cdr tokl)) (setq $tplvl -1))
	       (t (setq $tplvl (ogtnum (cadr tokl))))))
	((eq (car tokl) 'arrow)
	 (cond ((or (null (cdr tokl)) (eq (cadr tokl) 'normal))
		(setq $arrow-dir 'normal))
	       (t (setq $arrow-dir 'reverse))))
	(t (princ "Illegal parameter for set.") (nterpri))))

(defun ogtnum (tok)
  (prog (l n)
	(setq l (exploden tok))
	(setq n 0)
   aa   (cond ((or (null l) (not (rdigit (car l))))
