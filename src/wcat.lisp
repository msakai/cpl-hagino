; delete

(defun odel (tokl)
  (prog (mn bd)
	(cond ((null tokl) (princ "No name") (nterpri) (return nil)))
	(setq mn (car tokl))
	(cond ((get mn 'object) (return (odelo mn t))))
	(setq bd (get mn 'morphism))
	(cond ((null bd)
	       (princ mn) (princ " undefined") (nterpri) (return nil))
	      ((not (eq (car bd) 'auxiliary))
	       (oprinl `(,(car bd)
			 ,mn
			 "cannot be deleted separately from"
			 ,(cadr bd)))
	       (nterpri)
	       (return nil)))
	(return (odelm mn t))))

(defun odelm (aux dflg)
  (prog (depl)
	(setq depl (odelmd aux nil))
	(cond (depl (cond ((not dflg) (princ "Modified ")))
		    (princ aux)
		    (princ " was used in: ")
		    (oprinl depl)
		    (nterpri)))
   aa   (cond (depl (setf (get (car depl) 'incorrect) t)
		    (setq depl (cdr depl))
		    (go aa)))
	(remprop aux 'morphism)
	(remprop aux 'incorrect)
	(setq $morphism (odell $morphism (list aux)))
	(cond (dflg (oprinl `(,aux "deleted")) (nterpri)))
	(return t)))

(defun odelmd (aux depl)
  (prog (ml bd)
	(setq ml $morphism)
   aa   (cond ((null ml) (return depl))
	      ((memq (car ml) depl))
	      ((and (eq (car (setq bd (get (car ml) 'morphism))) 'auxiliary)
		    (odelmdml (caddr bd) aux))
	       (setq depl (odelmd (car ml) (cons (car ml) depl)))))
	(setq ml (cdr ml))
	(go aa)))

(defun odelmdmll (mll aux)
