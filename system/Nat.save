(setq $object '(nat bool coprod exp prod |1|))
(setq $morphism '(equal not or and lesseq minus sub1 fact mult add s |0| pr false true if in2 in1 case eval curry pi2 pi1 pair !))
(defprop |1| (right nil ! nil productive) object)
(defprop |1| (functor |1| nil nil) morphism)
(defprop prod (right (a b) pair ((pi1 prod a) (pi2 prod b)) productive) object)
(defprop prod (functor prod nil (covariant covariant)) morphism)
(defprop exp (right (a b) curry ((eval (object prod (exp a)) b)) productive) object)
(defprop exp (functor exp nil (contravariant covariant)) morphism)
(defprop coprod (left (a b) case ((in1 a coprod) (in2 b coprod)) coproductive) object)
(defprop coprod (functor coprod nil (covariant covariant)) morphism)
(defprop bool (left nil if ((true (object |1| nil) bool) (false (object |1| nil) bool)) nil) object)
(defprop bool (functor bool nil nil) morphism)
(defprop nat (left nil pr ((|0| (object |1| nil) nat) (s nat nat)) nil) object)
(defprop nat (functor nat nil nil) morphism)
(defprop ! (factorizer |1|) morphism)
(defprop pair (factorizer prod) morphism)
(defprop pi1 (unit prod prod a) morphism)
(defprop pi2 (unit prod prod b) morphism)
(defprop curry (factorizer exp) morphism)
(defprop eval (unit exp (object prod (exp a)) b) morphism)
(defprop case (factorizer coprod) morphism)
(defprop in1 (unit coprod a coprod) morphism)
(defprop in2 (unit coprod b coprod) morphism)
(defprop if (factorizer bool) morphism)
(defprop true (unit bool (object |1| nil) bool) morphism)
(defprop false (unit bool (object |1| nil) bool) morphism)
(defprop pr (factorizer nat) morphism)
(defprop |0| (unit nat (object |1| nil) nat) morphism)
(defprop s (unit nat nat nat) morphism)
(defprop add (auxiliary *auxiliary ((unit eval) (factorizer pair (((factorizer pr (((factorizer curry (((unit pi2))))) ((factorizer curry (((unit s) (unit eval))))))) (unit pi1)) ((unit pi2))))) nil (object prod ((object nat nil) (object nat nil))) (object nat nil)) morphism)
(defprop mult (auxiliary *auxiliary ((unit eval) (factorizer pair (((factorizer pr (((factorizer curry (((unit |0|) (factorizer ! nil))))) ((factorizer curry (((auxiliary add) (factorizer pair (((unit eval) (factorizer pair (((unit pi1)) ((unit pi2))))) ((unit pi2)))))))))) (unit pi1)) ((unit pi2))))) nil (object prod ((object nat nil) (object nat nil))) (object nat nil)) morphism)
(defprop fact (auxiliary *auxiliary ((unit pi1) (factorizer pr (((factorizer pair (((unit s) (unit |0|)) ((unit |0|))))) ((factorizer pair (((auxiliary mult) (factorizer pair (((unit s) (unit pi2)) ((unit pi1))))) ((unit s) (unit pi2)))))))) nil (object nat nil) (object nat nil)) morphism)
(defprop sub1 (auxiliary *auxiliary ((factorizer pr (((unit in2)) ((unit in1) (factorizer case (((unit s)) ((unit |0|)))))))) nil (object nat nil) (object coprod ((object nat nil) (object |1| nil)))) morphism)
(defprop minus (auxiliary *auxiliary ((unit eval) (factorizer pair (((factorizer pr (((factorizer curry (((unit in1) (unit pi2))))) ((factorizer curry (((factorizer case (((auxiliary sub1)) ((unit in2)))) (unit eval))))))) (unit pi1)) ((unit pi2)))) (factorizer pair (((unit pi2)) ((unit pi1))))) nil (object prod ((object nat nil) (object nat nil))) (object coprod ((object nat nil) (object |1| nil)))) morphism)
(defprop lesseq (auxiliary *auxiliary ((factorizer case (((unit true) (factorizer ! nil)) ((unit false)))) (auxiliary minus) (factorizer pair (((unit pi2)) ((unit pi1))))) nil (object prod ((object nat nil) (object nat nil))) (object bool nil)) morphism)
(defprop and (auxiliary *auxiliary ((unit eval) (factorizer pair (((factorizer if (((factorizer curry (((unit pi2))))) ((factorizer curry (((unit false) (factorizer ! nil))))))) (unit pi1)) ((unit pi2))))) nil (object prod ((object bool nil) (object bool nil))) (object bool nil)) morphism)
(defprop or (auxiliary *auxiliary ((unit eval) (factorizer pair (((factorizer if (((factorizer curry (((unit true) (factorizer ! nil))))) ((factorizer curry (((unit pi2))))))) (unit pi1)) ((unit pi2))))) nil (object prod ((object bool nil) (object bool nil))) (object bool nil)) morphism)
(defprop not (auxiliary *auxiliary ((factorizer if (((unit false)) ((unit true))))) nil (object bool nil) (object bool nil)) morphism)
(defprop equal (auxiliary *auxiliary ((auxiliary and) (factorizer pair (((auxiliary lesseq)) ((auxiliary lesseq) (factorizer pair (((unit pi2)) ((unit pi1)))))))) nil (object prod ((object nat nil) (object nat nil))) (object bool nil)) morphism)
(setq $aliases 'nil)
(setq $keypad 'nil)
